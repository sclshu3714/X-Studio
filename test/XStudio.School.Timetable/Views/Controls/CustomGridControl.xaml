<UserControl
    x:Class="XStudio.School.Timetable.Views.Controls.CustomGridControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:XStudio.School.Timetable.Views.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:util="clr-namespace:XStudio.School.Timetable.Utilities"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <ItemsControl ItemsSource="{Binding TimetableRows}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <!--  自定义布局面板  -->
                <util:CustomGridPanel />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <!--  单元格可视化模板  -->
                <Border
                    AllowDrop="True"
                    BorderBrush="Gray"
                    BorderThickness="0.5"
                    DragEnter="Border_DragEnter"
                    Drop="Cell_Drop"
                    PreviewMouseLeftButtonDown="Cell_PreviewMouseLeftButtonDown">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="{Binding Content}" />
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
