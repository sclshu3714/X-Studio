<UserControl
    x:Class="XStudio.App.Views.UserControls.MainViewContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ex="clr-namespace:XStudio.App.Extensions"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:langs="clr-namespace:XStudio.App.Properties.Langs"
    xmlns:local="clr-namespace:XStudio.App.Views.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <hc:SimplePanel>
        <Border
            Name="BorderRootEffect"
            Margin="8"
            Background="{DynamicResource RegionBrush}"
            CornerRadius="10"
            Effect="{StaticResource EffectShadow4}"
            Visibility="Collapsed" />
        <Border
            Name="BorderRoot"
            Margin="0"
            Style="{StaticResource BorderClip}">
            <Grid
                Name="GridMain"
                Margin="16,16,16,16"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Border
                    Name="BorderEffect"
                    Grid.RowSpan="2"
                    Background="{DynamicResource RegionBrush}"
                    CornerRadius="10"
                    Effect="{StaticResource EffectShadow4}" />
                <Border
                    Name="BorderTitle"
                    Grid.Row="0"
                    Height="32"
                    Background="{DynamicResource TitleBrush}"
                    CornerRadius="10,10,0,0"
                    Style="{StaticResource BorderClip}">
                    <hc:SimplePanel>
                        <hc:Watermark
                            FontSize="20"
                            FontWeight="Bold"
                            Mark="{Binding ContentTitle}"
                            MarkBrush="#0FD9104B"
                            MarkMargin="3,0" />
                        <TextBlock
                            Foreground="White"
                            Style="{StaticResource TextBlockDefault}"
                            Text="{Binding ContentTitle}" />
                        <ToggleButton
                            Margin="0,0,6,0"
                            Padding="5"
                            HorizontalAlignment="Right"
                            hc:IconElement.Geometry="{StaticResource CodeGeometry}"
                            Foreground="{DynamicResource TextIconBrush}"
                            IsChecked="{Binding IsCodeOpened}"
                            Style="{StaticResource ToggleButtonIconTransparent}" />
                        <Button
                            Width="30"
                            Height="26"
                            Margin="6,0,0,0"
                            Padding="5"
                            HorizontalAlignment="Left"
                            hc:IconElement.Geometry="{StaticResource DocumentGeometry}"
                            Command="{Binding OpenDocCmd}"
                            Foreground="{DynamicResource TextIconBrush}"
                            Style="{StaticResource ButtonIcon}" />
                        <hc:Drawer
                            Name="DrawerCode"
                            IsOpen="{Binding IsCodeOpened}"
                            Opened="DrawerCode_OnOpened">
                            <Border
                                Name="BorderCode"
                                Width="800"
                                Margin="16,16,0,16"
                                Background="{DynamicResource RegionBrush}"
                                CornerRadius="10,0,0,10"
                                Style="{StaticResource BorderClip}" />
                        </hc:Drawer>
                    </hc:SimplePanel>
                </Border>
                <hc:TabControl
                    Grid.Row="1"
                    Margin="3,3,3,3"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="0"
                    IsAnimationEnabled="True"
                    IsDraggable="True"
                    ItemsSource="{Binding DisplayAreaInfoCollection}"
                    OverflowMenuDisplayMemberPath="Header"
                    SelectedIndex="{Binding DisplayAreaSelectedIndex}"
                    ShowCloseButton="False"
                    TabStripPlacement="Bottom">
                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                VerticalAlignment="Center"
                                Background="Transparent"
                                Text="{Binding Header, Mode=TwoWay}"
                                TextAlignment="Center" />
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate>
                            <Border
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                Background="White"
                                BorderThickness="0">
                                <ContentControl Content="{Binding Content}" />
                            </Border>
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </hc:TabControl>
            </Grid>
        </Border>
    </hc:SimplePanel>
</UserControl>
