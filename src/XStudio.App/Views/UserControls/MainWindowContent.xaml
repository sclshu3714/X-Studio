<UserControl
    x:Class="XStudio.App.Views.UserControls.MainWindowContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:data="clr-namespace:XStudio.App.Models.Data"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:XStudio.App.Views.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="{StaticResource CloudDrawingBrush}"
    BorderBrush="{DynamicResource BorderBrush}"
    BorderThickness="0,1,0,0"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition
                x:Name="ColumnDefinitionLeft"
                Width="240"
                MinWidth="240"
                MaxWidth="400" />
            <ColumnDefinition Width="*" MinWidth="300" />
        </Grid.ColumnDefinitions>
        <Button
            x:Name="ButtonShiftOut"
            Margin="0,26,-16,0"
            Padding="8,8,0,8"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Panel.ZIndex="0"
            hc:IconElement.Geometry="{StaticResource LeftGeometry}"
            Click="OnLeftMainContentShiftOut"
            Style="{StaticResource ButtonIconCircular}" />
        <local:MainViewContent
            x:Name="mainContent"
            Grid.Column="1"
            Margin="0,0,0,0" />
        <local:LeftMainContent
            x:Name="leftMainContent"
            Grid.Column="0"
            Margin="0,0,0,0">
            <UIElement.RenderTransform>
                <TranslateTransform />
            </UIElement.RenderTransform>
        </local:LeftMainContent>
        <GridSplitter
            x:Name="gridSplitter"
            Grid.Column="0"
            Width="4"
            Margin="0,26,0,26"
            HorizontalAlignment="Right"
            Background="Transparent" />
        <Button
            x:Name="ButtonShiftIn"
            Grid.Column="0"
            Margin="-12,26,0,0"
            Padding="8,8,0,8"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            hc:IconElement.Geometry="{StaticResource RightGeometry}"
            Click="OnLeftMainContentShiftIn"
            Style="{StaticResource ButtonIconCircular}"
            Visibility="Collapsed" />
        <ScrollViewer
            Grid.Column="1"
            Margin="0,0,0,16"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            VerticalScrollBarVisibility="Hidden">
            <StackPanel
                Margin="0,0,0,16"
                VerticalAlignment="Bottom"
                hc:Growl.GrowlParent="True"
                hc:Growl.Token="{x:Static data:MessageToken.GrowlMainWindow}" />
        </ScrollViewer>
    </Grid>
</UserControl>
