<hc:Window
    x:Class="XStudio.App.Views.Module.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:data="clr-namespace:XStudio.App.Models.Data"
    xmlns:ex="clr-namespace:XStudio.App.Extensions"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:helper="clr-namespace:XStudio.App.Helper"
    xmlns:langs="clr-namespace:XStudio.App.Properties.Langs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    Title="{ex:Lang Key={x:Static langs:LangKeys.Title}}"
    Width="680"
    Height="400"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{StaticResource CloudDrawingBrush}"
    BorderBrush="{DynamicResource BorderBrush}"
    Icon="pack://application:,,,/XStudio.App;component/Resources/Img/xlogo.ico"
    ShowNonClientArea="False"
    ShowTitle="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <hc:TransitioningContentControl>
        <Border
            hc:WindowAttach.IsDragElement="True"
            Background="White"
            CornerRadius="5">
            <Grid hc:WindowAttach.IsDragElement="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="35" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Background="#3aaaaa">
                    <Image
                        Width="16"
                        Height="16"
                        Margin="12,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Source="pack://application:,,,/XStudio.App;component/Resources/Img/wxz.png" />
                </Border>
                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Background="#3aaaaa">
                    <hc:SimpleStackPanel
                        Margin="0,0,0,35"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Vertical">
                        <!--<hc:GifImage x:Name="GifImageMain" Width="160" Height="160" Stretch="None" Margin="0" Uri="/XStudio.App;component/Resources/Img/car_chase.gif"/>-->
                        <Image
                            Width="120"
                            Height="120"
                            Margin="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Source="pack://application:,,,/XStudio.App;component/Resources/Img/Album/14.png" />
                        <hc:OutlineText
                            HorizontalAlignment="Center"
                            Fill="{DynamicResource PrimaryBrush}"
                            FontSize="20"
                            FontWeight="Normal"
                            Stroke="{DynamicResource BorderBrush}"
                            StrokePosition="Outside"
                            StrokeThickness="1"
                            Text="{ex:Lang Key={x:Static langs:LangKeys.SignText},
                                           Converter={StaticResource StringRepeatConverter},
                                           ConverterParameter=1}" />
                    </hc:SimpleStackPanel>
                </Border>
                <Border Grid.Row="0" Grid.Column="1">
                    <Button
                        Name="CloseButton"
                        Grid.Column="1"
                        Margin="0,0,12,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        hc:IconElement.Geometry="{StaticResource CloseGeometry}"
                        hc:IconElement.Height="12"
                        hc:IconElement.Width="12"
                        Click="CloseButton_Click"
                        Style="{StaticResource ButtonIcon}" />
                </Border>
                <hc:SimpleStackPanel
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="10,10,10,50"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Vertical">
                    <Image
                        Width="64"
                        Height="64"
                        Margin="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Source="pack://application:,,,/XStudio.App;component/Resources/Img/DevOps/DevOps-Pipelines.png"
                        Stretch="Uniform" />
                    <hc:ComboBox x:Name="NameTextBox"
                                 MinWidth="250"
                                 MinHeight="40"
                                 Margin="0,4,0,0"
                                 hc:InfoElement.Necessary="True"
                                 hc:InfoElement.Placeholder="{ex:Lang Key={x:Static langs:LangKeys.LoginUserContent}}"
                                 hc:InfoElement.Title="{ex:Lang Key={x:Static langs:LangKeys.UserName}}"
                                 hc:InfoElement.TitlePlacement="Top"
                                 hc:InfoElement.TitleWidth="250"
                                 DisplayMemberPath="UserNameOrEmailAddress"
                                 IsEditable="True"
                                 ItemsSource="{Binding DefaultSelectList}"
                                 PreviewTextInput="NameTextBox_PreviewTextInput"
                                 SelectedValuePath="Index"
                                 SelectionChanged="NameTextBox_SelectionChanged"
                                 Style="{StaticResource ComboBoxExtend}">
                        <hc:ComboBox.Text>
                            <Binding Path="UserNameOrEmailAddress" 
                                     UpdateSourceTrigger="PropertyChanged"
                                     ValidatesOnDataErrors="True"
                                     NotifyOnValidationError="True"
                                     Mode="TwoWay">
                                <Binding.ValidationRules>
                                    <data:CompositeValidationRule Type="UserName" MinLength="6" MaxLength="16" />
                                </Binding.ValidationRules>
                            </Binding>
                        </hc:ComboBox.Text>
                    </hc:ComboBox>
                    <hc:PasswordBox x:Name="CodeTextBox"
                                    MinWidth="250"
                                    MinHeight="40"
                                    Margin="0,16,0,0"
                                    hc:InfoElement.IsReadOnly="True"
                                    hc:InfoElement.Necessary="True"
                                    hc:InfoElement.Placeholder="{ex:Lang Key={x:Static langs:LangKeys.LoginPasswordContent}}"
                                    hc:InfoElement.Title="{ex:Lang Key={x:Static langs:LangKeys.Password}}"
                                    hc:InfoElement.TitlePlacement="Top"
                                    hc:InfoElement.TitleWidth="250"
                                    Foreground="Black"
                                    ShowEyeButton="True">
                        <helper:PasswordBoxHelper.BindPassword>
                            <Binding Path="Password"
                                     UpdateSourceTrigger="PropertyChanged"
                                     ValidatesOnDataErrors="True"
                                     NotifyOnValidationError="True"
                                     Mode="TwoWay">
                                <Binding.ValidationRules>
                                    <data:CompositeValidationRule Type="Password"
                                                                  MinLength="6"
                                                                  MaxLength="16" />
                                </Binding.ValidationRules>
                            </Binding>
                        </helper:PasswordBoxHelper.BindPassword>
                    </hc:PasswordBox>
                    <CheckBox
                        Margin="0,16,0,0"
                        Content="{ex:Lang Key={x:Static langs:LangKeys.CheckBox}}"
                        IsChecked="{Binding RememberMe}" />
                    <ToggleButton
                        x:Name="LoginButton"
                        Width="250"
                        Height="40"
                        Margin="0,16,0,20"
                        hc:BorderElement.CornerRadius="4"
                        Background="#24292e"
                        Click="LoginButton_Click"
                        Content="{ex:Lang Key={x:Static langs:LangKeys.Login}}"
                        Cursor="Hand"
                        Foreground="{DynamicResource TextIconBrush}"
                        IsChecked="False"
                        Style="{StaticResource ToggleButtonLoadingLogin}">
                        <hc:StatusSwitchElement.CheckedElement>
                            <Border Background="{DynamicResource PrimaryBrush}">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#24292e"
                                    Foreground="{DynamicResource TextIconBrush}"
                                    IsEnabled="False"
                                    Text="{ex:Lang Key={x:Static langs:LangKeys.Logging}}" />
                            </Border>
                        </hc:StatusSwitchElement.CheckedElement>
                    </ToggleButton>
                </hc:SimpleStackPanel>
                <hc:ScrollViewer
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="1"
                    HorizontalAlignment="Center"
                    IsInertiaEnabled="True"
                    IsPenetrating="True"
                    VerticalScrollBarVisibility="Hidden">
                    <StackPanel
                        Margin="0,0,0,0"
                        VerticalAlignment="Top"
                        hc:Growl.ShowMode="Prepend"
                        hc:Growl.Token="{x:Static data:MessageToken.GrowlLoginWindow}" />
                </hc:ScrollViewer>
            </Grid>
        </Border>
    </hc:TransitioningContentControl>
</hc:Window>
