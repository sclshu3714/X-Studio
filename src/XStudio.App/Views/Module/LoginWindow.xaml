<hc:BlurWindow
    x:Class="XStudio.App.Views.Module.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:ex="clr-namespace:XStudio.App.Extensions"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:langs="clr-namespace:XStudio.App.Properties.Langs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prism="http://prismlibrary.com/"
    Title="{ex:Lang Key={x:Static langs:LangKeys.Title}}"
    Width="680"
    Height="500"
    prism:ViewModelLocator.AutoWireViewModel="True"
    Background="{StaticResource CloudDrawingBrush}"
    BorderBrush="{DynamicResource BorderBrush}"
    Icon="pack://application:,,,/XStudio.App;component/Resources/Img/xlogo.ico"
    ShowNonClientArea="False"
    ShowTitle="True"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Border Background="White" CornerRadius="5">
        <Grid hc:WindowAttach.IsDragElement="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#3aaaaa" />
        </Grid>
    </Border>
</hc:BlurWindow>
