<Page
    x:Class="XStudio.App.Views.Module.TimePeriodPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:local="clr-namespace:XStudio.App.Views.Module"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="TimePeriodPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <hc:TransitioningContentControl>
        <Grid>
            <hc:UniformSpacingPanel Orientation="Vertical" Spacing="3">
                <hc:UniformSpacingPanel ChildWrapping="Wrap"
                                        Spacing="32"
                                        Background="White">
                    <hc:SimplePanel HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                        <Rectangle
                            Height="30"
                            Margin="3"
                            VerticalAlignment="Top"
                            RadiusX="4"
                            RadiusY="4"
                            Stroke="{DynamicResource Brush.Effects}"
                            StrokeDashArray="2,2" />
                        <hc:ButtonGroup Margin="5,0,0,0" VerticalAlignment="Center">
                            <Button
                                Margin="0"
                                hc:IconElement.Geometry="{StaticResource SaveGeometry}"
                                hc:IconElement.Height="12"
                                hc:IconElement.Width="12"
                                Command="{Binding SaveCommand}"
                                CommandParameter="{Binding}"
                                Content="保 存"
                                Style="{StaticResource ButtonBaseStyle}" />
                            <Button
                                Margin="0"
                                hc:IconElement.Geometry="{StaticResource AddGeometry}"
                                hc:IconElement.Height="12"
                                hc:IconElement.Width="12"
                                Command="{Binding AddCommand}"
                                Content="添 加"
                                Style="{StaticResource ButtonBaseStyle}" />
                        </hc:ButtonGroup>
                    </hc:SimplePanel>
                </hc:UniformSpacingPanel>
                <hc:UniformSpacingPanel ChildWrapping="Wrap"
                                        Spacing="32"
                                        Background="White">
                    <DataGrid
                        x:Name="dataTimePeriod"
                        HorizontalAlignment="Center"
                        HorizontalContentAlignment="Center"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        ItemsSource="{Binding TimePeriods}"
                        MinRowHeight="35">
                        <DataGrid.Columns>
                            <!--  示例数据列  -->
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Name}"
                                Header="名称" />
                            <!--  不可编辑  -->
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Code}"
                                Header="编码"
                                IsReadOnly="True" />

                            <!--  操作列  -->
                            <DataGridTemplateColumn Width="200" Header="操作">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                            <Button
                                                Margin="15,0,0,0"
                                                hc:IconElement.Geometry="{StaticResource UpGeometry}"
                                                hc:IconElement.Height="12"
                                                hc:IconElement.Width="12"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.UpCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}" />
                                            <Button
                                                Margin="15,0,0,0"
                                                hc:IconElement.Geometry="{StaticResource DownGeometry}"
                                                hc:IconElement.Height="12"
                                                hc:IconElement.Width="12"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.DownCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}" />
                                            <Button
                                                Margin="15,0,0,0"
                                                hc:IconElement.Geometry="{StaticResource DeleteGeometry}"
                                                hc:IconElement.Height="12"
                                                hc:IconElement.Width="12"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </hc:UniformSpacingPanel>
            </hc:UniformSpacingPanel>
            <hc:SimplePanel
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Panel.ZIndex="100"
                Background="White"
                Opacity="0.8"
                Visibility="{Binding IsLoading, Converter={StaticResource Boolean2VisibilityConverter}}">
                <hc:LoadingCircle
                    x:Name="theLoading"
                    Width="50"
                    Height="50"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    DotBorderThickness="20"
                    DotCount="6"
                    Foreground="Red"
                    IsRunning="True" />
            </hc:SimplePanel>
        </Grid>
    </hc:TransitioningContentControl>
</Page>
