<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ex="clr-namespace:XStudio.App.Extensions"
    xmlns:hc="https://handyorg.github.io/handycontrol"
    xmlns:langs="clr-namespace:XStudio.App.Properties.Langs"
    xmlns:local="clr-namespace:XStudio.App.ViewModel">
    <DataTemplate x:Key="TextFieldTemplate">
        <TextBox
            MinWidth="250"
            MinHeight="40"
            Margin="0,16,0,0"
            hc:InfoElement.IsReadOnly="True"
            hc:InfoElement.Necessary="True"
            hc:InfoElement.Placeholder="{ex:Lang Key={x:Static langs:LangKeys.PlsEnterContent}}"
            hc:InfoElement.Title="{ex:Lang Key={x:Static langs:LangKeys.Code}}"
            hc:InfoElement.TitlePlacement="Top"
            hc:InfoElement.TitleWidth="250"
            Foreground="Black"
            IsReadOnly="True"
            Style="{StaticResource TextBoxExtend}"
            Text="{Binding Code, Mode=TwoWay}" />
    </DataTemplate>
    <DataTemplate x:Key="EmailFieldTemplate">
        <StackPanel Orientation="Horizontal">
            <TextBlock Margin="0,0,5,0" Text="{Binding Label}" />
            <TextBox InputScope="EmailSmtpAddress" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="NumberFieldTemplate">
        <StackPanel Orientation="Horizontal">
            <TextBlock Margin="0,0,5,0" Text="{Binding Label}" />
            <TextBox InputScope="Number" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
    </DataTemplate>
    <DataTemplate x:Key="FieldTemplateSelector">
        <ContentControl Content="{Binding}" ContentTemplateSelector="{StaticResource FieldTemplateSelectorResource}" />
    </DataTemplate>
    <local:FieldTemplateSelector x:Key="FieldTemplateSelectorResource">
        <local:FieldTemplateSelector.TextTemplate>
            <StaticResource ResourceKey="TextFieldTemplate" />
        </local:FieldTemplateSelector.TextTemplate>
        <local:FieldTemplateSelector.EmailTemplate>
            <StaticResource ResourceKey="EmailFieldTemplate" />
        </local:FieldTemplateSelector.EmailTemplate>
        <local:FieldTemplateSelector.NumberTemplate>
            <StaticResource ResourceKey="NumberFieldTemplate" />
        </local:FieldTemplateSelector.NumberTemplate>
    </local:FieldTemplateSelector>
</ResourceDictionary>